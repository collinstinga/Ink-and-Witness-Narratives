# ==============================================================================
# INK & WITNESS - ENVIRONMENT VARIABLES & SECURITY SECRETS
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# SECURE INITIAL ADMINISTRATOR PROVISIONING (SERVER-SIDE SETUP ONLY)
# On first boot or setup, the system creates an admin user with these credentials
# using Argon2id password hashing. Passwords are never hard-coded in source code.
# ==============================================================================
INITIAL_ADMIN_EMAIL="admin@inkandwitness.com"
INITIAL_ADMIN_PASSWORD=""

# Session cookie secret and encryption options
SESSION_SECRET=""

# ==============================================================================
# SAFARICOM DARAJA M-PESA PRODUCTION CREDENTIALS
# SECURITY WARNING & ROTATION REQUIREMENT:
# Any M-Pesa credentials (Consumer Key, Consumer Secret, Passkey, Shortcode, Till)
# previously exposed in code or commits MUST be considered compromised and rotated
# immediately in the Safaricom Daraja Developer portal before processing live payments.
#
# Credentials are read strictly from backend environment secrets and never hardcoded.
# ==============================================================================

# Live Safaricom Daraja Environment ('production' or 'sandbox')
MPESA_ENV="production"

# Live Daraja Consumer Key (from Safaricom Developer Portal)
MPESA_CONSUMER_KEY=""

# Live Daraja Consumer Secret (from Safaricom Developer Portal)
MPESA_CONSUMER_SECRET=""

# Live Lipa Na M-Pesa Online Passkey
MPESA_PASSKEY=""

# Live Store / Business Shortcode
MPESA_SHORTCODE=""

# Live Buy Goods Till Number
MPESA_TILL_NUMBER=""

# Store number (if different from shortcode)
MPESA_STORE_NUMBER=""

# PayBill business number (required only for PayBill mode)
MPESA_PAYBILL_NUMBER=""

# Payment rail and matching Daraja transaction type. These two values must agree.
MPESA_PAYMENT_TYPE="till"
MPESA_TRANSACTION_TYPE="CustomerBuyGoodsOnline"

# Account reference (max 12 alphanumeric characters)
MPESA_ACCOUNT_REF="INKWITNESS"

# Production HTTPS Webhook Callback URL for Daraja Result Notifications
MPESA_CALLBACK_URL=""

