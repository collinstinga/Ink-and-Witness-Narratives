{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Published and draft literary pieces, essays, and erotica narratives",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "topicId": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "isPaid": { "type": "boolean" },
        "priceKes": { "type": "number" },
        "readTimeMinutes": { "type": "number" },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "featured": { "type": "boolean" },
        "downloadsCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "tags": { "type": "array" },
        "coverImage": { "type": "string" },
        "excerpt": { "type": "string" },
        "previewParagraphs": { "type": "array" },
        "content": { "type": "string" },
        "pdfDownloadUrl": { "type": "string" },
        "customPriceUSD": { "type": "number" },
        "displayOrder": { "type": "number" },
        "pinned": { "type": "boolean" }
      },
      "required": ["id", "title", "status", "createdAt"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Literary topic category in the catalogue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "displayOrder": { "type": "number" },
        "homepageVisible": { "type": "boolean" },
        "pieceIds": { "type": "array" },
        "sortMode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "AffiliateAccount": {
      "title": "AffiliateAccount",
      "description": "Affiliate partner account details, referral code, balances, and private authentication state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "passwordHash": { "type": "string", "description": "Server-only Argon2id credential hash; never returned to browsers" },
        "sessionVersion": { "type": "string", "description": "Server-only 256-bit revocation generation; never returned to browsers" },
        "referralCode": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "payoutMethod": { "type": "string", "enum": ["mpesa", "bank", "pesapal_paypal"] },
        "payoutDetails": { "type": "object" },
        "commissionRate": { "type": "number" },
        "totalEarningsKes": { "type": "number" },
        "pendingBalanceKes": { "type": "number" },
        "paidBalanceKes": { "type": "number" },
        "totalClicks": { "type": "number" },
        "totalSales": { "type": "number" },
        "registeredAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "acceptedTerms": { "type": "boolean" },
        "acceptedTermsAt": { "type": "string" },
        "termsVersion": { "type": "string" }
      },
      "required": ["id", "email", "name", "referralCode", "status"]
    },
    "AffiliateSession": {
      "title": "AffiliateSession",
      "description": "Server-only affiliate session metadata stored under a one-way hash of a signed bearer token",
      "type": "object",
      "properties": {
        "storageVersion": { "type": "number", "enum": [2] },
        "affiliateId": { "type": "string" },
        "sessionVersion": { "type": "string", "description": "Private revocation generation copied from the affiliate account" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["storageVersion", "affiliateId", "sessionVersion", "createdAt", "expiresAt"]
    },
    "AffiliateIdentityReservation": {
      "title": "AffiliateIdentityReservation",
      "description": "Server-only transactional ownership reservation preventing duplicate affiliate codes or emails",
      "type": "object",
      "properties": {
        "affiliateId": { "type": "string" },
        "affiliateCode": { "type": "string" },
        "emailHash": { "type": "string" },
        "reservedAt": { "type": "string" },
        "deletedAt": { "type": "string" }
      },
      "required": ["affiliateId", "reservedAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Reader payment transaction and M-Pesa payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "checkoutRequestId": { "type": "string" },
        "paymentAttemptId": { "type": "string", "description": "Stable random correlation ID generated for each STK request and exposed to the browser only while provider correlation is incomplete" },
        "merchantRequestId": { "type": "string" },
        "mpesaReceiptNumber": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "articleId": { "type": "string" },
        "articleTitle": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "originalAmount": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "exchangeRateTimestamp": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "type": { "type": "string", "enum": ["PURCHASE", "TIP", "MANUAL", "TEST"] },
        "status": { "type": "string", "enum": ["INITIATED", "STK_SENT", "PENDING", "CONFIRMED", "SUCCESS", "PAID", "FAILED", "CANCELLED", "TIMEOUT", "TIMED_OUT", "EXPIRED"] },
        "resultCode": { "type": "number" },
        "resultDesc": { "type": "string" },
        "transactionTimestamp": { "type": "string" },
        "bankReference": { "type": "string" },
        "bankOrderReference": { "type": "string" },
        "affiliateCode": { "type": "string" },
        "campaignCode": { "type": "string" },
        "affiliateAttributionAt": { "type": "string", "description": "Signed referral issuance time copied into the checkout ledger" },
        "affiliateAttributionExpiresAt": { "type": "string", "description": "Signed referral expiry copied into the checkout ledger" },
        "shortcodeUsed": { "type": "string" },
        "paymentCapabilityHash": { "type": "string", "description": "Server-only SHA-256 hash of the browser payment-status capability" },
        "callbackCapabilityHash": { "type": "string", "description": "Server-only SHA-256 hash of the per-request Daraja callback URL capability" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "downloadToken": { "type": "string" }
      },
      "required": ["id", "checkoutRequestId", "articleId", "amount", "type", "status", "createdAt"]
    },
    "MpesaCallbackIntent": {
      "title": "MpesaCallbackIntent",
      "description": "Short-lived, server-only pre-Daraja recovery record containing only hashed browser and callback capabilities",
      "type": "object",
      "properties": {
        "version": { "type": "number", "enum": [1] },
        "callbackCapabilityHash": { "type": "string" },
        "paymentCapabilityHash": { "type": "string" },
        "paymentAttemptId": { "type": "string", "description": "Stable random correlation ID; optional only for legacy in-flight intents created before this field existed" },
        "requestLockId": { "type": "string" },
        "articleId": { "type": "string" },
        "articleTitle": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "originalAmount": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "exchangeRateTimestamp": { "type": "string" },
        "type": { "type": "string", "enum": ["PURCHASE", "TIP"] },
        "affiliateCode": { "type": "string" },
        "campaignCode": { "type": "string" },
        "affiliateAttributionAt": { "type": "string" },
        "affiliateAttributionExpiresAt": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "shortcodeUsed": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "checkoutRequestId": { "type": "string" },
        "merchantRequestId": { "type": "string" },
        "status": { "type": "string", "enum": ["PREPARED", "ATTACHED"] },
        "attachedAt": { "type": "string" }
      },
      "required": ["version", "callbackCapabilityHash", "paymentCapabilityHash", "requestLockId", "articleId", "phoneNumber", "amount", "type", "createdAt", "expiresAt", "status"]
    },
    "MpesaRequestLock": {
      "title": "MpesaRequestLock",
      "description": "Short duplicate-suppression lock keyed by a one-way hash of piece and phone",
      "type": "object",
      "properties": {
        "version": { "type": "number", "enum": [1] },
        "requestLockId": { "type": "string" },
        "callbackCapabilityHash": { "type": "string" },
        "paymentCapabilityHash": { "type": "string" },
        "articleId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["version", "requestLockId", "callbackCapabilityHash", "paymentCapabilityHash", "articleId", "phoneNumber", "createdAt", "expiresAt"]
    },
    "AffiliateCommissionOutboxEntry": {
      "title": "AffiliateCommissionOutboxEntry",
      "description": "Durable retry marker coupling a confirmed checkout to one deterministic affiliate commission",
      "type": "object",
      "properties": {
        "checkoutRequestId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "COMPLETE", "SKIPPED"] },
        "commissionId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["checkoutRequestId", "status", "updatedAt"]
    },
    "ReaderLicense": {
      "title": "ReaderLicense",
      "description": "Verified unlock license for a reader to access paid narrative pieces",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "articleId": { "type": "string" },
        "phone": { "type": "string" },
        "receipt": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "number" },
        "verified": { "type": "boolean" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "accessSource": { "type": "string", "enum": ["MPESA_PURCHASE", "MANUAL_GRANT", "SYSTEM"] }
      },
      "required": ["token", "articleId", "phone"]
    },
    "MpesaPublicConfig": {
      "title": "MpesaPublicConfig",
      "description": "Non-secret M-Pesa rail and display settings. Provider credentials are environment-only and must never be stored in Firestore.",
      "type": "object",
      "properties": {
        "paymentType": { "type": "string", "enum": ["till", "paybill"] },
        "transactionType": { "type": "string", "enum": ["CustomerBuyGoodsOnline", "CustomerPayBillOnline"] },
        "shortcode": { "type": "string" },
        "tillNumber": { "type": "string" },
        "tillName": { "type": "string" },
        "storeNumber": { "type": "string" },
        "paybillNumber": { "type": "string" },
        "accountReference": { "type": "string" },
        "businessPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "callPhoneNumber": { "type": "string" },
        "env": { "type": "string", "enum": ["sandbox", "production"] },
        "callbackUrl": { "type": "string" },
        "defaultPriceKes": { "type": "number" },
        "tippingEnabled": { "type": "boolean" },
        "minTipKes": { "type": "number" },
        "secretStorageVersion": { "type": "number", "description": "Migration marker confirming provider credentials are isolated from Firestore" }
      },
      "required": ["paymentType", "shortcode", "accountReference", "env", "defaultPriceKes", "secretStorageVersion"]
    },
    "HomepageConfig": {
      "title": "HomepageConfig",
      "description": "Curated layout, welcome background, hero quote, and section text",
      "type": "object",
      "properties": {
        "welcomeBackground": { "type": "object" },
        "startHerePieceIds": { "type": "array" },
        "startHereHeading": { "type": "string" },
        "startHereSubtitle": { "type": "string" },
        "theWritingHeading": { "type": "string" },
        "theWritingSubtitle": { "type": "string" },
        "aboutTheWritingHeading": { "type": "string" },
        "aboutTheWritingStatement": { "type": "string" },
        "aboutTheWritingPurpose": { "type": "string" },
        "aboutTheWritingButtonText": { "type": "string" },
        "heroHeadline": { "type": "string" },
        "heroQuote": { "type": "string" },
        "heroSubheadline": { "type": "string" },
        "heroCtaText": { "type": "string" },
        "mostSellingPieceIds": { "type": "array" },
        "pieceOfTheWeekId": { "type": "string" },
        "mostSellingMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AuthorProfile": {
      "title": "AuthorProfile",
      "description": "Jake's official author biography, avatar, cover photo, branding, and stats",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "instagram": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "extendedBio": { "type": "string" },
        "location": { "type": "string" },
        "featuredQuote": { "type": "string" },
        "stats": { "type": "object" },
        "avatarUrl": { "type": "string" },
        "avatarSavedPermanently": { "type": "boolean" },
        "avatarSavedAt": { "type": "string" },
        "coverPhotoUrl": { "type": "string" },
        "coverPhotoSavedPermanently": { "type": "boolean" },
        "coverPhotoSavedAt": { "type": "string" },
        "welcomeBackgroundUrl": { "type": "string" },
        "welcomeBackgroundSavedPermanently": { "type": "boolean" },
        "welcomeBackgroundSavedAt": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "faviconSavedPermanently": { "type": "boolean" },
        "faviconSavedAt": { "type": "string" },
        "logoUrl": { "type": "string" },
        "logoSavedPermanently": { "type": "boolean" },
        "logoSavedAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "SavedAsset": {
      "title": "SavedAsset",
      "description": "Permanently stored and server-validated JPEG, PNG, or WebP branding photo, monograph cover, or site asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "target": { "type": "string" },
        "filename": { "type": "string" },
        "url": { "type": "string" },
        "dataUrl": { "type": "string" },
        "mimeType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
        "size": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "sanitized": { "type": "boolean", "description": "True when the server decoded and re-encoded the stored image" },
        "articleId": { "type": "string" },
        "savedPermanently": { "type": "boolean" },
        "savedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "url", "savedPermanently"]
    },
    "User": {
      "title": "User",
      "description": "Registered user account record with argon2id hashed credentials and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "AuthSession": {
      "title": "AuthSession",
      "description": "Active authenticated user session record stored under a one-way SHA-256 document identifier; the signed reusable cookie token is never stored",
      "type": "object",
      "properties": {
        "storageVersion": { "type": "number", "enum": [2] },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["storageVersion", "userId", "role", "email", "name", "createdAt", "expiresAt"]
    },
    "ManualAccessGrant": {
      "title": "ManualAccessGrant",
      "description": "Administrator-granted manual reading access for specific readers without requiring M-Pesa payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "articleId": { "type": "string" },
        "articleTitle": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "grantedAt": { "type": "string" },
        "grantedBy": { "type": "string" },
        "accessType": { "type": "string", "enum": ["manual"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "articleId", "phone", "status", "grantedAt", "grantedBy", "accessType"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "All literary pieces, essays, and stories"
    },
    "/uploaded_assets/{assetId}": {
      "schema": "SavedAsset",
      "description": "Permanently saved image assets and branding files"
    },
    "/topics/{topicId}": {
      "schema": "Topic",
      "description": "Curated topics for catalogue grouping"
    },
    "/categories/{categoryId}": {
      "schema": "Topic",
      "description": "Curated categories for catalogue grouping"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and role definitions"
    },
    "/sessions/{hashedSessionId}": {
      "schema": "AuthSession",
      "description": "Active user sessions keyed by v2_<sha256(cookie token)>"
    },
    "/affiliates/{affiliateId}": {
      "schema": "AffiliateAccount",
      "description": "Affiliate accounts and profiles"
    },
    "/affiliate_sessions/{hashedSessionId}": {
      "schema": "AffiliateSession",
      "description": "Signed affiliate sessions keyed by v2_<sha256(cookie token)>; bearer values are never persisted"
    },
    "/affiliate_codes/{normalizedCode}": {
      "schema": "AffiliateIdentityReservation",
      "description": "Permanent transactional affiliate-code ownership reservation; codes are not silently reassigned"
    },
    "/affiliate_emails/{emailHash}": {
      "schema": "AffiliateIdentityReservation",
      "description": "Transactional affiliate-email ownership reservation keyed by SHA-256 email hash"
    },
    "/transactions/{transactionId}": {
      "schema": "PaymentTransaction",
      "description": "M-Pesa payment transactions and receipts"
    },
    "/mpesa_callback_intents/{callbackCapabilityHash}": {
      "schema": "MpesaCallbackIntent",
      "description": "Pre-provider recovery intent keyed by a callback capability hash"
    },
    "/mpesa_payment_intents/{paymentCapabilityHash}": {
      "schema": "MpesaCallbackIntent",
      "description": "Mirrored recovery intent keyed by a browser payment capability hash"
    },
    "/mpesa_request_locks/{requestLockId}": {
      "schema": "MpesaRequestLock",
      "description": "Two-minute duplicate M-Pesa request lock"
    },
    "/affiliate_commission_outbox/{checkoutRequestHash}": {
      "schema": "AffiliateCommissionOutboxEntry",
      "description": "Durable commission reconciliation marker keyed by a checkout hash"
    },
    "/reader_licenses/{token}": {
      "schema": "ReaderLicense",
      "description": "Verified reader unlock tokens"
    },
    "/manual_access/{grantId}": {
      "schema": "ManualAccessGrant",
      "description": "Admin manual access authorizations for monographs"
    },
    "/site_configs/mpesa_settings": {
      "schema": "MpesaPublicConfig",
      "description": "Non-secret M-Pesa rail settings; provider credentials live only in protected runtime environment variables"
    },
    "/site_configs/{configId}": {
      "schema": "HomepageConfig",
      "description": "Global homepage and author profile configuration"
    }
  }
}
